# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# place_embeddings 조회 등 서비스 롤 전용 작업에 사용 (절대 브라우저에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# CLIP 이미지 임베딩은 외부 API 없이 Transformers.js로 서버에서 직접 실행한다
# (Hugging Face 무료 Inference API가 더 이상 CLIP 이미지 인코더를 서빙하지 않음).
# 필요 시에만 override — 기본값: Xenova/clip-vit-base-patch32
CLIP_MODEL=

# 카카오맵 JavaScript SDK / 카카오 로컬 API
NEXT_PUBLIC_KAKAO_MAP_KEY=
KAKAO_REST_API_KEY=

# 한국관광공사 TourAPI (공공데이터포털)
TOUR_API_KEY=
